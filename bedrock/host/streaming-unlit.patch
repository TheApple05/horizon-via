+    /// A server column without usable light: discard its light and wait for
+    /// local lighting over its complete 3x3 region before admitting new meshes.
+    /// Resident neighbours keep their previous light while their relights run.
+    /// Reject incompatible layouts or coordinates before changing any state.
+    pub fn insert_remote_unlit(
+        &mut self,
+        world: &mut World,
+        mut chunk: Chunk,
+    ) -> Result<(), RemoteUnlitError> {
+        if chunk.layout() != world.layout() {
+            return Err(RemoteUnlitError::LayoutMismatch);
+        }
+        let (x, z) = (chunk.x, chunk.z);
+        let bounds = |v: i32| -> Result<(i32, i32), RemoteUnlitError> {
+            // Radius-two meshes read a third ring and blend biome samples up
+            // to seven blocks past their own column. Keep that entire outer
+            // footprint representable as host block coordinates, not just
+            // the chunk keys used to invalidate work below.
+            v.checked_sub(3)
+                .and_then(|c| c.checked_mul(16))
+                .zip(
+                    v.checked_add(3)
+                        .and_then(|c| c.checked_mul(16))
+                        .and_then(|origin| origin.checked_add(15)),
+                )
+                .ok_or(RemoteUnlitError::CoordinateOverflow)?;
+            Ok((v - 2, v + 2))
+        };
+        let (x0, x1) = bounds(x)?;
+        let (z0, z1) = bounds(z)?;
+        // Section defaults contain full skylight. Neither those defaults nor a
+        // packet's supplied values are evidence of local lighting completion.
+        chunk.lit = false;
+        chunk.light_loaded = false;
+        for section in &mut chunk.sections {
+            Arc::make_mut(section).light = crate::chunk::Light::Uniform(0);
+        }
+        world.chunks.insert((x, z), Arc::new(chunk));
+        world.revision = world.revision.wrapping_add(1);
+        self.lit.remove(&(x, z));
+        self.meshed.remove(&(x, z));
+        self.generated_total += 1;
+        // Every light job whose immutable 3x3 snapshot included this column is
+        // obsolete, including jobs still waiting in the done mailbox. Removing
+        // their sequence tokens makes update reject them even after replacement.
+        for nz in z - 1..=z + 1 {
+            for nx in x - 1..=x + 1 {
+                self.lighting.remove(&(nx, nz));
+                self.light_snapshots.remove(&(nx, nz));
+                world.dirty_light.insert((nx, nz));
+            }
+        }
+        // Those relights can change light sampled by their own neighbours.
+        // Invalidate old mesh/compile tokens throughout that second ring, but
+        // retain resident columns and uploaded presentation until rebuilt.
+        for nz in z0..=z1 {
+            for nx in x0..=x1 {
+                for sy in 0..world.layout().sections() as i32 {
+                    let section = (nx, sy, nz);
+                    self.meshing.remove(&section);
+                    self.compile_started.remove(&section);
+                    self.waiting.remove(&section);
+                    world.dirty_sections.insert(section);
+                }
+            }
+        }
+        Ok(())
+    }
