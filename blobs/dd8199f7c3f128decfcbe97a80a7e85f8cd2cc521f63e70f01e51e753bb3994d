// Original factual raw47 bounds-height table from actual vanilla getBounds, with air neighbours.
use crate::{Error, Result};
#[derive(Clone, Copy, Debug, PartialEq)]
pub struct Bounds {
    pub height: f64,
    pub air: bool,
    pub requires_neighbors: bool,
}
pub fn lookup(raw: u16) -> Result<Bounds> {
    let index = HEIGHTS
        .binary_search_by_key(&raw, |row| row.0)
        .map_err(|_| Error::new("unrecognized vanilla47 bounds state"))?;
    let (_, height, flags) = HEIGHTS[index];
    Ok(Bounds {
        height,
        air: flags & 1 != 0,
        requires_neighbors: flags & 2 != 0,
    })
}
